# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (VERCEL & RAILWAY)
# Copy to Vercel Environment Variables in production.

NODE_ENV=production
PORT=5000

# Railway MySQL Database Connection URL
DATABASE_URL="mysql://root:wXfTCATdQYdZMOMrvNWOnUjcYVPoxhlf@altaria.proxy.rlwy.net:47880/railway?sslaccept=accept_invalid_certs"

# JWT Authentication Secrets (Generate 32-character random hex strings: e.g. openssl rand -hex 32)
JWT_SECRET="REPLACE_WITH_SECURE_32_CHAR_JWT_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_SECURE_32_CHAR_REFRESH_SECRET"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Production Client URL (Used for CORS and HttpOnly cookie origin validation)
CLIENT_URL="https://YOUR-FRONTEND.vercel.app"
COOKIE_SAMESITE="none"

# Phase 10 SMTP Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM_NAME="My Sakthi Marketing"
MAIL_FROM_ADDRESS="no-reply@mysakthimarketing.in"
