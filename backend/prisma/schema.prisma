datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  PAID
  CANCELLED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  SYSTEM
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
}

model User {
  id                      String              @id @default(uuid())
  userCode                String              @unique @map("user_code")
  fullName                String              @map("full_name")
  email                   String              @unique
  phone                   String              @unique
  passwordHash            String              @map("password_hash")
  transactionPasswordHash String              @map("transaction_password_hash")
  role                    Role                @default(MEMBER)
  status                  UserStatus          @default(ACTIVE)
  
  // Sponsor relationship (Self-relation for downline tree tracking)
  sponsorId               String?             @map("sponsor_id")
  sponsor                 User?               @relation("SponsorRelation", fields: [sponsorId], references: [id], onDelete: SetNull)
  referrals               User[]              @relation("SponsorRelation")

  // Related Entities
  bankDetails             UserBankDetails?
  commissionsEarned       Commission[]        @relation("MemberCommissions")
  commissionsGenerated    Commission[]        @relation("SourceCommissions")
  payoutRequests          PayoutRequest[]     @relation("MemberPayoutRequests")
  reviewedPayouts         PayoutRequest[]     @relation("AdminPayoutReviews")
  notifications           Notification[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([sponsorId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model UserBankDetails {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number")
  ifscCode      String   @map("ifsc_code")
  bankName      String   @map("bank_name")
  branchName    String   @map("branch_name")
  isVerified    Boolean  @default(false) @map("is_verified")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("user_bank_details")
}

model Referral {
  id                String     @id @default(uuid())
  sponsorCode       String     @map("sponsor_code")
  referredUserCode  String     @map("referred_user_code")
  status            UserStatus @default(ACTIVE)
  registeredAt      DateTime   @default(now()) @map("registered_at")
  eligibilityStatus String     @default("PENDING") @map("eligibility_status")

  @@index([sponsorCode])
  @@index([referredUserCode])
  @@map("referrals")
}

model Commission {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation("MemberCommissions", fields: [userId], references: [id], onDelete: Cascade)
  sourceUserId String   @map("source_user_id")
  sourceUser   User     @relation("SourceCommissions", fields: [sourceUserId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(10, 2)
  type         String   
  status       String   @default("APPROVED")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sourceUserId])
  @@map("commissions")
}

model RewardRule {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  description      String?  @db.Text
  bonusAmount      Decimal  @map("bonus_amount") @db.Decimal(10, 2)
  levelRequirement Int      @default(1) @map("level_requirement")
  isActive         Boolean  @default(true) @map("is_active")
  effectiveDate    DateTime @default(now()) @map("effective_date")
  expiryDate       DateTime? @map("expiry_date")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("reward_rules")
}

model PayoutRequest {
  id                          String       @id @default(uuid())
  userId                      String       @map("user_id")
  user                        User         @relation("MemberPayoutRequests", fields: [userId], references: [id], onDelete: Cascade)
  amount                      Decimal      @db.Decimal(10, 2)
  bankSnapshot                Json         @map("bank_snapshot")
  status                      PayoutStatus @default(PENDING)
  transactionPasswordVerified Boolean      @default(true) @map("transaction_password_verified")
  transactionRef              String?      @map("transaction_ref")
  adminNotes                  String?      @map("admin_notes") @db.Text
  reviewedById                String?      @map("reviewed_by_id")
  reviewedBy                  User?        @relation("AdminPayoutReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt                   DateTime     @default(now()) @map("created_at")
  reviewedAt                  DateTime?    @map("reviewed_at")

  @@index([userId])
  @@index([status])
  @@map("payout_requests")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?   @db.Text
  imageUrl     String?   @map("image_url")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  products     Product[]
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id               String         @id @default(uuid())
  categoryId       String         @map("category_id")
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name             String
  slug             String         @unique
  shortDescription String?        @map("short_description") @db.VarChar(500)
  description      String         @db.Text
  price            Decimal        @db.Decimal(10, 2)
  stock            Int            @default(0)
  isFeatured       Boolean        @default(false) @map("is_featured")
  displayOrder     Int            @default(0) @map("display_order")
  isActive         Boolean        @default(true) @map("is_active")
  images           ProductImage[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String   @map("image_url")
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  imageUrl     String   @map("image_url")
  linkUrl      String?  @map("link_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model ContactEnquiry {
  id         String        @id @default(uuid())
  name       String
  email      String
  phone      String?
  message    String        @db.Text
  status     EnquiryStatus @default(NEW)
  adminNotes String?       @map("admin_notes") @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("contact_enquiries")
}

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @db.LongText
  metaDescription String?  @map("meta_description")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

model Testimonial {
  id           String   @id @default(uuid())
  name         String
  designation  String?
  content      String   @db.Text
  avatarUrl    String?  @map("avatar_url")
  rating       Int      @default(5)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

model Faq {
  id           String   @id @default(uuid())
  question     String   @db.VarChar(500)
  answer       String   @db.Text
  category     String   @default("General")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("faqs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String   @db.Text
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model EmailLog {
  id           String      @id @default(uuid())
  recipient    String
  subject      String
  emailType    String      @map("email_type")
  status       EmailStatus @default(PENDING)
  attemptCount Int         @default(0) @map("attempt_count")
  lastAttemptAt DateTime?  @map("last_attempt_at")
  sentAt       DateTime?   @map("sent_at")
  failedAt     DateTime?   @map("failed_at")
  errorCode    String?     @map("error_code")
  errorMessage String?     @map("error_message") @db.Text
  messageId    String?     @map("message_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([recipient])
  @@index([emailType])
  @@index([createdAt])
  @@map("email_logs")
}
